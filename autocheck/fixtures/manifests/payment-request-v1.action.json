{
  "module": "payment",
  "action": "request",
  "version": 1,
  "http_method": "POST",
  "target_schema": "api",
  "target_function": "payment_request",
  "request_schema": {
    "type": "object",
    "required": [ "operationKind", "amount", "currency" ],
    "properties": {
      "operationKind": {
        "type": "string",
        "enum": [ "PAYMENT_EXECUTION", "PAYMENT_APPROVAL" ]
      },
      "amount": { "type": "string" },
      "currency": {
        "type": "string",
        "const": "RUB"
      }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "type": "object",
    "required": [ "operationId", "requestId", "operationKind", "amount", "currency", "status" ],
    "properties": {
      "operationId": { "type": "string" },
      "requestId": { "type": "string" },
      "operationKind": { "type": "string" },
      "amount": { "type": "string" },
      "currency": { "type": "string" },
      "status": { "type": "string" }
    },
    "additionalProperties": false
  },
  "outcomes": [ "CREATED" ],
  "required_policy": [ "payment:write" ],
  "idempotency_mode": "required",
  "idempotency_scope": "principal_action",
  "timeout_ms": 10000
}